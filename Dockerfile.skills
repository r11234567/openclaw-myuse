ARG OPENCLAW_BASE_IMAGE=openclaw:local
ARG OPENCLAW_NODE_BOOKWORM_IMAGE="docker.io/library/node:24-bookworm@sha256:8530f76a96d88820d288761f022e318970dda93d01536919fbc16076b7983e63"

# Heavy media/tooling dependencies live in this derived image, not in the
# primary gateway image. The primary image still includes /app/skills; this file
# only adds system/Python/npm/Go tools that some skills may call at runtime.
FROM ${OPENCLAW_NODE_BOOKWORM_IMAGE} AS go-tools
ARG TARGETARCH=amd64
ARG GO_VERSION=1.25.5

RUN set -eux; \
    case "$TARGETARCH" in \
      amd64) go_asset="go${GO_VERSION}.linux-amd64.tar.gz" ;; \
      arm64) go_asset="go${GO_VERSION}.linux-arm64.tar.gz" ;; \
      *) echo "Unsupported TARGETARCH for skill Go tools: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates curl git; \
    mkdir -p /tmp/openclaw-skill-tools/bin /tmp/go; \
    curl -fsSLo /tmp/go.tar.gz "https://go.dev/dl/${go_asset}"; \
    tar -xzf /tmp/go.tar.gz -C /tmp/go --strip-components=1; \
    GOBIN=/tmp/openclaw-skill-tools/bin /tmp/go/bin/go install github.com/steipete/gifgrep/cmd/gifgrep@latest; \
    GOBIN=/tmp/openclaw-skill-tools/bin /tmp/go/bin/go install github.com/steipete/songsee/cmd/songsee@latest

FROM ${OPENCLAW_BASE_IMAGE}

USER root

ARG TARGETARCH=amd64
ARG JQ_VERSION=1.8.1
ARG RIPGREP_VERSION=15.1.0
ARG SHERPA_ONNX_VERSION=1.13.2
ARG OPENCLAW_SKILLS_APT_PACKAGES="bzip2 ca-certificates curl ffmpeg git python3-pip tesseract-ocr poppler-utils"
ARG OPENCLAW_SKILLS_PIP_PACKAGES="--index-url https://download.pytorch.org/whl/cpu --extra-index-url https://pypi.org/simple torch==2.9.1+cpu openai-whisper nano-pdf"
ARG OPENCLAW_SKILLS_NPM_PACKAGES="@steipete/oracle @steipete/summarize mcporter"
ARG OPENCLAW_SKILLS_INSTALL_SHERPA=1

ENV PATH="/home/node/.local/bin:/opt/openclaw-skill-tools/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ENV SHERPA_ONNX_RUNTIME_DIR="/opt/openclaw-skill-tools/sherpa-onnx-tts/runtime"
ENV SHERPA_ONNX_MODEL_DIR="/opt/openclaw-skill-tools/sherpa-onnx-tts/models/vits-piper-en_US-lessac-high"

COPY --from=go-tools /tmp/openclaw-skill-tools/bin/ /opt/openclaw-skill-tools/bin/

RUN --mount=type=cache,id=openclaw-skills-apt-cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=openclaw-skills-apt-lists,target=/var/lib/apt,sharing=locked \
    set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends bzip2 ca-certificates curl; \
    if [ -n "$OPENCLAW_SKILLS_APT_PACKAGES" ]; then \
      DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends $OPENCLAW_SKILLS_APT_PACKAGES; \
    fi; \
    if [ -n "$OPENCLAW_SKILLS_PIP_PACKAGES" ]; then \
      if ! python3 -m pip --version >/dev/null 2>&1; then \
        apt-get update; \
        DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends python3-pip; \
      fi; \
      python3 -m pip install --no-cache-dir --break-system-packages $OPENCLAW_SKILLS_PIP_PACKAGES; \
    fi; \
    if [ -n "$OPENCLAW_SKILLS_NPM_PACKAGES" ]; then \
      npm install -g $OPENCLAW_SKILLS_NPM_PACKAGES; \
    fi; \
    mkdir -p /home/node/.local /opt/openclaw-skill-tools/bin /opt/openclaw-skill-tools/downloads; \
    cd /opt/openclaw-skill-tools/downloads; \
    case "$TARGETARCH" in \
      amd64) jq_asset=jq-linux-amd64; rg_asset="ripgrep-${RIPGREP_VERSION}-x86_64-unknown-linux-musl.tar.gz"; sherpa_asset="sherpa-onnx-v${SHERPA_ONNX_VERSION}-linux-x64-shared.tar.bz2" ;; \
      arm64) jq_asset=jq-linux-arm64; rg_asset="ripgrep-${RIPGREP_VERSION}-aarch64-unknown-linux-gnu.tar.gz"; sherpa_asset="" ;; \
      *) echo "Unsupported TARGETARCH for skill tools: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    curl -fsSLo /opt/openclaw-skill-tools/bin/jq "https://github.com/jqlang/jq/releases/download/jq-${JQ_VERSION}/${jq_asset}"; \
    chmod 0755 /opt/openclaw-skill-tools/bin/jq; \
    curl -fsSLo ripgrep.tar.gz "https://github.com/BurntSushi/ripgrep/releases/download/${RIPGREP_VERSION}/${rg_asset}"; \
    mkdir -p ripgrep; \
    tar -xzf ripgrep.tar.gz -C ripgrep --strip-components=1; \
    install -m 0755 ripgrep/rg /opt/openclaw-skill-tools/bin/rg; \
    if [ "$OPENCLAW_SKILLS_INSTALL_SHERPA" != "0" ] && [ -n "$sherpa_asset" ]; then \
      curl -fsSLo sherpa-runtime.tar.bz2 "https://github.com/k2-fsa/sherpa-onnx/releases/download/v${SHERPA_ONNX_VERSION}/${sherpa_asset}"; \
      mkdir -p "$SHERPA_ONNX_RUNTIME_DIR"; \
      tar -xjf sherpa-runtime.tar.bz2 -C "$SHERPA_ONNX_RUNTIME_DIR" --strip-components=1; \
      curl -fsSLo sherpa-lessac.tar.bz2 "https://github.com/k2-fsa/sherpa-onnx/releases/download/tts-models/vits-piper-en_US-lessac-high.tar.bz2"; \
      mkdir -p /opt/openclaw-skill-tools/sherpa-onnx-tts/models; \
      tar -xjf sherpa-lessac.tar.bz2 -C /opt/openclaw-skill-tools/sherpa-onnx-tts/models; \
    fi; \
    chown -R node:node /opt/openclaw-skill-tools /home/node/.local; \
    rm -rf /opt/openclaw-skill-tools/downloads /root/.cache /root/.npm /root/go/pkg/mod/cache

USER node
